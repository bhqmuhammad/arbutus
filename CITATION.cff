# Technical specifications
technical-details:
  file-formats:
    - ".fmt (Arbutus format definitions)"
    - ".fil (Arbutus data files)"
    - ".avw (Arbutus analysis views)"
    - ".pro (Arbutus SmartApp procedures)"
    - ".xlsx/.xls (Excel data files)"
    - ".pdf (Documentation)"
    - ".html (Interactive reports)"
  
  software-compatibility:
    - "Arbutus Analyzer (all versions)"
    - "ATLAS 2018 v2.0.1"
    - "Microsoft Excel 2016+"
    - "Modern web browsers"